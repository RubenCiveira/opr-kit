{
  "name": "@rubenciveira/opr-kit",
  "version": "0.2.0",
  "description": "Logica y vistas de ejercitos de One Page Rules (constructor, reglas, cartas, impresion e importacion de Army Forge), independientes del backend.",
  "keywords": [
    "one-page-rules",
    "opr",
    "army-forge",
    "wargames",
    "grimdark-future",
    "age-of-fantasy"
  ],
  "license": "MIT",
  "author": "Ruben Civeira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RubenCiveira/opr-kit.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "import": "./dist/core/*.js"
    },
    "./react/*": {
      "types": "./dist/react/*.d.ts",
      "import": "./dist/react/*.js"
    }
  },
  "scripts": {
    "build": "tsup && cp src/styles.css dist/styles.css",
    "typecheck": "tsc -p .",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
